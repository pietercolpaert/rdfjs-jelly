{
  "name": "rdfjs-jelly",
  "version": "0.1.6",
  "description": "Jelly-RDF parser and writer for RDF/JS in Node.js and browsers",
  "keywords": [
    "rdf",
    "rdf-js",
    "jelly",
    "protobuf",
    "streaming"
  ],
  "license": "Apache-2.0",
  "author": "Pieter Colpaert",
  "type": "commonjs",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "browser": "./dist/browser/index.mjs",
  "unpkg": "./dist/browser/index.global.js",
  "jsdelivr": "./dist/browser/index.global.js",
  "bin": {
    "rdfjs-jelly": "./bin/rdfjs-jelly.mjs"
  },
  "exports": {
    ".": {
      "browser": {
        "types": "./dist/browser/index.d.mts",
        "default": "./dist/browser/index.mjs"
      },
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./browser": {
      "types": "./dist/browser/index.d.mts",
      "default": "./dist/browser/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist/index.*",
    "dist/browser/index.*",
    "src",
    "proto",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "npm run build:node && npm run build:browser",
    "build:node": "tsup src/index.ts --format cjs,esm --dts --target node24 --platform node --clean --splitting false --out-dir dist",
    "build:browser": "tsup src/browser.ts --format esm --dts --dts-only --out-dir dist/browser-types --clean && node scripts/build-browser.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --cache --max-warnings 0",
    "check": "npm run typecheck && npm run lint && npm run proto:check && npm run build && npm run test:perf && npm run test:coverage && npm run lint:package && npm run test:package",
    "ci": "npm run check",
    "prepare": "npm run build",
    "proto:generate": "node scripts/generate-proto.mjs",
    "proto:check": "node scripts/check-proto.mjs",
    "perf": "npm run build && node perf/bench.mjs",
    "perf:quick": "npm run build && node perf/bench.mjs 10000",
    "perf:profile": "npm run build && node --expose-gc perf/profile-breakdown.mjs",
    "perf:profile:writer": "npm run build && node --expose-gc perf/profile-writer.mjs",
    "perf:compare:rdf-parser": "npm run build && node --expose-gc perf/compare-rdf-parser.mjs",
    "perf:compare:messages": "npm run build && node perf/compare-message-formats.mjs",
    "test:coverage": "vitest run --coverage",
    "test:conformance": "vitest run test/conformance.test.ts test/rdf12.test.ts test/sparql.test.ts",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint --strict && attw --pack . --profile node16 --entrypoints . package.json && attw --pack . --profile esm-only --entrypoints browser",
    "test:package": "node scripts/test-package.mjs",
    "test:browser": "node scripts/test-package.mjs --browser",
    "prepublishOnly": "npm run check",
    "perf:regression": "node --expose-gc perf/regression.mjs",
    "perf:quality": "node --expose-gc perf/quality.mjs --profile",
    "test:interop": "node scripts/test-writer-interop.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:perf": "node --test perf/quality.test.mjs"
  },
  "dependencies": {
    "@rdfjs/types": "^2.0.1",
    "protobufjs": "^8.6.5",
    "rdf-parser-ts": "^0.3.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "protobufjs-cli": "^2.5.5",
    "publint": "^0.3.25",
    "tsup": "^8.5.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "homepage": "https://github.com/pietercolpaert/rdfjs-jelly#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pietercolpaert/rdfjs-jelly.git"
  },
  "bugs": {
    "url": "https://github.com/pietercolpaert/rdfjs-jelly/issues"
  }
}
